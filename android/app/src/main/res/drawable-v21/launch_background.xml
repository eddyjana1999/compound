<?xml version="1.0" encoding="utf-8"?>
<!-- The brand green with the growth mark centred, matching the app icon. The
     default was a plain white screen, which flashed white before the app drew
     and read as a stall rather than a launch. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
